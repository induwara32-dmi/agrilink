# syntax=docker/dockerfile:1.7
FROM node:22-alpine AS dependencies
WORKDIR /app
RUN apk add --no-cache openssl
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS development
COPY . .
RUN npx prisma generate
EXPOSE 4000
CMD ["npm", "run", "backend:dev"]

FROM dependencies AS builder
COPY . .
RUN npx prisma generate && npm run backend:build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache openssl && addgroup --system --gid 1001 agrilink && adduser --system --uid 1001 --ingroup agrilink agrilink
COPY --from=builder --chown=agrilink:agrilink /app/node_modules ./node_modules
COPY --from=builder --chown=agrilink:agrilink /app/dist/backend ./dist/backend
COPY --from=builder --chown=agrilink:agrilink /app/package.json ./package.json
COPY --from=builder --chown=agrilink:agrilink /app/prisma ./prisma
RUN npm prune --omit=dev
USER agrilink
EXPOSE 4000
CMD ["node", "dist/backend/server.js"]
