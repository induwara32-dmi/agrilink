generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  FARMER
  TRANSPORTER
  ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum FarmerOrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  REJECTED
  CANCELLED
}

enum DeliveryMethod {
  FARMER_DELIVERY
  BUYER_PICKUP
  PLATFORM_TRANSPORTER
}

enum DeliveryStatus {
  PENDING
  AWAITING_ASSIGNMENT
  ASSIGNED
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum PaymentTransactionType {
  AUTHORIZATION
  CAPTURE
  CHARGE
  REFUND
  VOID
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  TRICYCLE
  CAR
  PICKUP_TRUCK
  VAN
  REFRIGERATED_VAN
  TRUCK
  OTHER
}

enum InventoryMovementType {
  STOCK_IN
  RESERVATION
  RESERVATION_RELEASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  EXPIRY
}

enum TransportJobStatus {
  OPEN
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  ACCOUNT
  ORDER
  DELIVERY
  PAYMENT
  MESSAGE
  REVIEW
  SYSTEM
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id                   String                    @id @default(uuid()) @db.Uuid
  email                String                    @unique @db.VarChar(320)
  phone                String?                   @unique @db.VarChar(32)
  passwordHash         String                    @db.VarChar(255)
  role                 Role
  status               AccountStatus             @default(PENDING_VERIFICATION)
  emailVerifiedAt      DateTime?                 @db.Timestamptz(6)
  phoneVerifiedAt      DateTime?                 @db.Timestamptz(6)
  lastLoginAt          DateTime?                 @db.Timestamptz(6)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?                 @db.Timestamptz(6)
  profile              Profile?
  buyerProfile         BuyerProfile?
  farmerProfile        FarmerProfile?
  transporterProfile   TransporterProfile?
  adminProfile         AdminProfile?
  addresses            Address[]
  carts                Cart[]
  wishlists            Wishlist[]
  orders               Order[]                   @relation("BuyerOrders")
  vehicles             Vehicle[]                 @relation("VehicleOwner")
  inventoryMovements   InventoryMovement[]       @relation("InventoryMovementActor")
  orderStatusChanges   OrderStatusHistory[]      @relation("OrderStatusActor")
  farmerOrderStatusChanges FarmerOrderStatusHistory[] @relation("FarmerOrderStatusActor")
  deliveryStatusChanges DeliveryStatusHistory[]  @relation("DeliveryStatusActor")
  acceptedTransportJobs TransportJob[]            @relation("TransportJobAcceptor")
  notifications        Notification[]
  conversationMemberships ConversationParticipant[]
  messages             Message[]                 @relation("MessageSender")
  reviewsWritten       Review[]                  @relation("ReviewAuthor")
  reviewsReceived      Review[]                  @relation("ReviewSubject")
  couponRedemptions    CouponRedemption[]
  auditLogs            AuditLog[]                @relation("AuditActor")
  provisionedAdmins    AdminProfile[]            @relation("AdminProvisioner")
  recentlyViewedItems  RecentlyViewedItem[]

  @@index([role, status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Profile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  firstName  String   @db.VarChar(100)
  lastName   String   @db.VarChar(100)
  displayName String? @db.VarChar(150)
  avatarUrl  String?  @db.Text
  locale     String   @default("en") @db.VarChar(10)
  timeZone   String   @default("UTC") @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BuyerProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FarmerProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  farmName           String             @db.VarChar(180)
  description        String?            @db.Text
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  verifiedAt         DateTime?          @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?          @db.Timestamptz(6)
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  products           Product[]
  farmerOrders       FarmerOrder[]

  @@index([verificationStatus])
  @@index([deletedAt])
}

model TransporterProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  businessName       String?            @db.VarChar(180)
  licenseNumber      String?            @unique @db.VarChar(100)
  verificationStatus VerificationStatus @default(NOT_SUBMITTED)
  verifiedAt         DateTime?          @db.Timestamptz(6)
  isAvailable        Boolean            @default(false)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?          @db.Timestamptz(6)
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  transportJobs      TransportJob[]

  @@index([verificationStatus, isAvailable])
  @@index([deletedAt])
}

model AdminProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  title      String?  @db.VarChar(120)
  createdBy  String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  provisioner User?   @relation("AdminProvisioner", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdBy])
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  label        String?  @db.VarChar(80)
  recipientName String  @db.VarChar(180)
  recipientPhone String @db.VarChar(32)
  line1        String   @db.VarChar(255)
  line2        String?  @db.VarChar(255)
  city         String   @db.VarChar(120)
  district     String?  @db.VarChar(120)
  region       String?  @db.VarChar(120)
  postalCode   String?  @db.VarChar(32)
  countryCode  String   @db.Char(2)
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  carts        Cart[]   @relation("CartDeliveryAddress")

  @@index([userId, isDefault])
  @@index([userId, deletedAt])
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @db.Uuid
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(140)
  description String?    @db.Text
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?  @db.Timestamptz(6)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId, isActive])
  @@index([deletedAt])
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  farmerId    String        @db.Uuid
  categoryId  String        @db.Uuid
  name        String        @db.VarChar(180)
  slug        String        @unique @db.VarChar(220)
  description String        @db.Text
  sku         String?       @unique @db.VarChar(100)
  unit        String        @db.VarChar(40)
  unitPrice   Decimal       @db.Decimal(19, 4)
  currency    String        @default("USD") @db.Char(3)
  minOrderQuantity Decimal  @default(1) @db.Decimal(18, 3)
  status      ProductStatus @default(DRAFT)
  publishedAt DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime?     @db.Timestamptz(6)
  farmer      FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  inventory   Inventory?
  cartItems   CartItem[]
  wishlistItems WishlistItem[]
  orderItems  OrderItem[]
  recentlyViewedItems RecentlyViewedItem[]

  @@index([farmerId, status])
  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([deletedAt])
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  storageKey String   @unique @db.VarChar(500)
  url        String   @db.Text
  altText    String?  @db.VarChar(255)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sortOrder])
  @@index([productId])
}

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @unique @db.Uuid
  quantityOnHand    Decimal  @default(0) @db.Decimal(18, 3)
  quantityReserved  Decimal  @default(0) @db.Decimal(18, 3)
  reorderLevel      Decimal? @db.Decimal(18, 3)
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements         InventoryMovement[]

  @@index([quantityOnHand])
}

model InventoryMovement {
  id          String                @id @default(uuid()) @db.Uuid
  inventoryId String                @db.Uuid
  actorId     String?               @db.Uuid
  type        InventoryMovementType
  quantity    Decimal               @db.Decimal(18, 3)
  balanceAfter Decimal              @db.Decimal(18, 3)
  referenceType String?             @db.VarChar(60)
  referenceId String?               @db.Uuid
  reason      String?               @db.VarChar(255)
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)
  inventory   Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  actor       User?                 @relation("InventoryMovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([referenceType, referenceId])
  @@index([actorId])
}

model Cart {
  id                String     @id @default(uuid()) @db.Uuid
  buyerId           String     @db.Uuid
  deliveryAddressId String?    @db.Uuid
  isActive          Boolean    @default(true)
  expiresAt         DateTime?  @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)
  buyer             User       @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  deliveryAddress   Address?   @relation("CartDeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items             CartItem[]

  // PostgreSQL migration must add a partial unique index for one active cart per buyer.
  @@index([buyerId, isActive])
  @@index([expiresAt])
}

model CartItem {
  id             String         @id @default(uuid()) @db.Uuid
  cartId         String         @db.Uuid
  productId      String         @db.Uuid
  quantity       Decimal        @db.Decimal(18, 3)
  deliveryMethod DeliveryMethod?
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(uuid()) @db.Uuid
  buyerId   String         @unique @db.Uuid
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)
  buyer     User           @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  items     WishlistItem[]
}

model WishlistItem {
  id         String    @id @default(uuid()) @db.Uuid
  wishlistId String    @db.Uuid
  productId  String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  wishlist   Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
}

model RecentlyViewedItem {
  id         String   @id @default(uuid()) @db.Uuid
  buyerId    String   @db.Uuid
  productId  String   @db.Uuid
  viewedAt   DateTime @default(now()) @db.Timestamptz(6)
  buyer      User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buyerId, productId])
  @@index([buyerId, viewedAt])
  @@index([productId])
}

model Order {
  id             String       @id @default(uuid()) @db.Uuid
  orderNumber    String       @unique @db.VarChar(40)
  buyerId        String       @db.Uuid
  status         OrderStatus  @default(PENDING)
  currency       String       @db.Char(3)
  subtotal       Decimal      @db.Decimal(19, 4)
  deliveryTotal  Decimal      @default(0) @db.Decimal(19, 4)
  discountTotal  Decimal      @default(0) @db.Decimal(19, 4)
  taxTotal       Decimal      @default(0) @db.Decimal(19, 4)
  grandTotal     Decimal      @db.Decimal(19, 4)
  placedAt       DateTime?    @db.Timestamptz(6)
  cancelledAt    DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  buyer          User         @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  farmerOrders   FarmerOrder[]
  statusHistory  OrderStatusHistory[]
  payment        Payment?
  couponRedemptions CouponRedemption[]
  conversations  Conversation[]

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

model FarmerOrder {
  id             String            @id @default(uuid()) @db.Uuid
  farmerOrderNumber String         @unique @db.VarChar(50)
  orderId        String            @db.Uuid
  farmerId       String            @db.Uuid
  status         FarmerOrderStatus @default(PENDING)
  deliveryMethod DeliveryMethod
  currency       String            @db.Char(3)
  subtotal       Decimal           @db.Decimal(19, 4)
  deliveryFee    Decimal           @default(0) @db.Decimal(19, 4)
  discountTotal  Decimal           @default(0) @db.Decimal(19, 4)
  taxTotal       Decimal           @default(0) @db.Decimal(19, 4)
  total          Decimal           @db.Decimal(19, 4)
  deliveryRecipientName  String?   @db.VarChar(180)
  deliveryRecipientPhone String?   @db.VarChar(32)
  deliveryLine1          String?   @db.VarChar(255)
  deliveryLine2          String?   @db.VarChar(255)
  deliveryCity           String?   @db.VarChar(120)
  deliveryDistrict       String?   @db.VarChar(120)
  deliveryRegion         String?   @db.VarChar(120)
  deliveryCountryCode    String?   @db.Char(2)
  buyerNotes     String?           @db.Text
  acceptedAt     DateTime?         @db.Timestamptz(6)
  completedAt    DateTime?         @db.Timestamptz(6)
  cancelledAt    DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  farmer         FarmerProfile     @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  delivery       Delivery?
  reviews        Review[]
  statusHistory  FarmerOrderStatusHistory[]
  conversations  Conversation[]

  // One row is the immutable commercial and delivery snapshot for one farmer in a checkout.
  @@unique([orderId, farmerId])
  @@index([farmerId, status, createdAt])
  @@index([orderId])
}

model OrderItem {
  id            String      @id @default(uuid()) @db.Uuid
  farmerOrderId String      @db.Uuid
  productId     String      @db.Uuid
  productName   String      @db.VarChar(180)
  sku           String?     @db.VarChar(100)
  unit          String      @db.VarChar(40)
  quantity      Decimal     @db.Decimal(18, 3)
  unitPrice     Decimal     @db.Decimal(19, 4)
  lineTotal     Decimal     @db.Decimal(19, 4)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  farmerOrder   FarmerOrder @relation(fields: [farmerOrderId], references: [id], onDelete: Restrict)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([farmerOrderId, productId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  actorId   String?     @db.Uuid
  fromStatus OrderStatus?
  toStatus  OrderStatus
  reason    String?     @db.VarChar(255)
  metadata  Json?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor     User?       @relation("OrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([actorId])
}

model FarmerOrderStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  farmerOrderId String             @db.Uuid
  actorId       String?            @db.Uuid
  fromStatus    FarmerOrderStatus?
  toStatus      FarmerOrderStatus
  reason        String?            @db.VarChar(255)
  metadata      Json?
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  farmerOrder   FarmerOrder        @relation(fields: [farmerOrderId], references: [id], onDelete: Restrict)
  actor         User?              @relation("FarmerOrderStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([farmerOrderId, createdAt])
  @@index([actorId])
}

model Delivery {
  id             String         @id @default(uuid()) @db.Uuid
  farmerOrderId  String         @unique @db.Uuid
  vehicleId      String?        @db.Uuid
  method         DeliveryMethod
  status         DeliveryStatus @default(PENDING)
  pickupCodeHash String?        @db.VarChar(255)
  scheduledPickupAt DateTime?   @db.Timestamptz(6)
  estimatedDeliveryAt DateTime? @db.Timestamptz(6)
  pickedUpAt     DateTime?      @db.Timestamptz(6)
  deliveredAt    DateTime?      @db.Timestamptz(6)
  proofStorageKey String?       @db.VarChar(500)
  recipientName  String?        @db.VarChar(180)
  recipientNote  String?        @db.Text
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  farmerOrder    FarmerOrder    @relation(fields: [farmerOrderId], references: [id], onDelete: Restrict)
  vehicle        Vehicle?       @relation("DirectDeliveryVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  statusHistory  DeliveryStatusHistory[]
  transportJob   TransportJob?
  routePlan      RoutePlan?

  // vehicleId is for farmer-delivery or buyer-pickup vehicles; platform vehicles live on TransportJob.
  @@index([status, scheduledPickupAt])
  @@index([vehicleId])
}

model DeliveryStatusHistory {
  id         String          @id @default(uuid()) @db.Uuid
  deliveryId String          @db.Uuid
  actorId    String?         @db.Uuid
  fromStatus DeliveryStatus?
  toStatus   DeliveryStatus
  note       String?         @db.VarChar(255)
  latitude   Decimal?        @db.Decimal(10, 7)
  longitude  Decimal?        @db.Decimal(10, 7)
  occurredAt DateTime        @default(now()) @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)
  delivery   Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  actor      User?           @relation("DeliveryStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([deliveryId, occurredAt])
  @@index([actorId])
}

model Vehicle {
  id             String      @id @default(uuid()) @db.Uuid
  ownerId        String      @db.Uuid
  type           VehicleType
  registrationNumber String  @unique @db.VarChar(64)
  make           String?     @db.VarChar(80)
  model          String?     @db.VarChar(80)
  color          String?     @db.VarChar(50)
  capacity       Decimal?    @db.Decimal(18, 3)
  capacityUnit   String?     @db.VarChar(30)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?   @db.Timestamptz(6)
  owner          User        @relation("VehicleOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  directDeliveries Delivery[] @relation("DirectDeliveryVehicle")
  transportJobs  TransportJob[]

  @@index([ownerId, isActive])
  @@index([type, isActive])
  @@index([deletedAt])
}

model TransportJob {
  id            String             @id @default(uuid()) @db.Uuid
  deliveryId    String             @unique @db.Uuid
  transporterId String?            @db.Uuid
  acceptedById  String?            @db.Uuid
  vehicleId     String?            @db.Uuid
  status        TransportJobStatus @default(OPEN)
  offeredFee    Decimal            @db.Decimal(19, 4)
  currency      String             @db.Char(3)
  acceptedAt    DateTime?          @db.Timestamptz(6)
  startedAt     DateTime?          @db.Timestamptz(6)
  completedAt   DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
  delivery      Delivery           @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  transporter   TransporterProfile? @relation(fields: [transporterId], references: [id], onDelete: Restrict)
  acceptedBy    User?              @relation("TransportJobAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  vehicle       Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([transporterId, status])
  @@index([vehicleId])
}

model RoutePlan {
  id            String   @id @default(uuid()) @db.Uuid
  deliveryId    String   @unique @db.Uuid
  originLabel   String   @db.VarChar(255)
  destinationLabel String @db.VarChar(255)
  originLatitude Decimal? @db.Decimal(10, 7)
  originLongitude Decimal? @db.Decimal(10, 7)
  destinationLatitude Decimal? @db.Decimal(10, 7)
  destinationLongitude Decimal? @db.Decimal(10, 7)
  distanceKm    Decimal? @db.Decimal(12, 3)
  estimatedMinutes Int?
  encodedPath   String?  @db.Text
  providerReference String? @db.VarChar(255)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  delivery      Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @unique @db.Uuid
  status         PaymentStatus @default(PENDING)
  provider       String        @db.VarChar(80)
  providerReference String?    @unique @db.VarChar(255)
  currency       String        @db.Char(3)
  amount         Decimal       @db.Decimal(19, 4)
  amountPaid     Decimal       @default(0) @db.Decimal(19, 4)
  amountRefunded Decimal       @default(0) @db.Decimal(19, 4)
  authorizedAt   DateTime?     @db.Timestamptz(6)
  paidAt         DateTime?     @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions   PaymentTransaction[]

  @@index([status, createdAt])
}

model PaymentTransaction {
  id              String                   @id @default(uuid()) @db.Uuid
  paymentId       String                   @db.Uuid
  type            PaymentTransactionType
  status          PaymentTransactionStatus @default(PENDING)
  idempotencyKey  String                   @unique @db.VarChar(255)
  providerTransactionId String?            @unique @db.VarChar(255)
  amount          Decimal                  @db.Decimal(19, 4)
  currency        String                   @db.Char(3)
  failureCode     String?                  @db.VarChar(100)
  failureMessage  String?                  @db.VarChar(500)
  providerPayload Json?
  processedAt     DateTime?                @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(6)
  payment         Payment                  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

model Review {
  id            String      @id @default(uuid()) @db.Uuid
  farmerOrderId String      @db.Uuid
  authorId      String      @db.Uuid
  subjectId     String      @db.Uuid
  rating        Int
  title         String?     @db.VarChar(150)
  comment       String?     @db.Text
  isVisible     Boolean     @default(true)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?   @db.Timestamptz(6)
  farmerOrder   FarmerOrder @relation(fields: [farmerOrderId], references: [id], onDelete: Restrict)
  author        User        @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  subject       User        @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([farmerOrderId, authorId, subjectId])
  @@index([subjectId, isVisible, createdAt])
  @@index([authorId])
  @@index([deletedAt])
}

model Notification {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @db.Uuid
  type       NotificationType
  status     NotificationStatus @default(PENDING)
  title      String             @db.VarChar(180)
  body       String             @db.Text
  data       Json?
  readAt     DateTime?          @db.Timestamptz(6)
  sentAt     DateTime?          @db.Timestamptz(6)
  createdAt  DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime           @updatedAt @db.Timestamptz(6)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model Conversation {
  id            String                    @id @default(uuid()) @db.Uuid
  subject       String?                   @db.VarChar(180)
  orderId       String?                   @db.Uuid
  farmerOrderId String?                   @db.Uuid
  createdAt     DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?                 @db.Timestamptz(6)
  participants  ConversationParticipant[]
  messages      Message[]
  order         Order?                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  farmerOrder   FarmerOrder?               @relation(fields: [farmerOrderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([farmerOrderId])
  @@index([updatedAt])
  @@index([deletedAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now()) @db.Timestamptz(6)
  leftAt         DateTime?    @db.Timestamptz(6)
  lastReadAt     DateTime?    @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String?      @db.Uuid
  type           MessageType  @default(TEXT)
  body           String       @db.Text
  attachmentUrl  String?      @db.Text
  sentAt         DateTime     @default(now()) @db.Timestamptz(6)
  editedAt       DateTime?    @db.Timestamptz(6)
  deletedAt      DateTime?    @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, sentAt])
  @@index([senderId])
}

model Coupon {
  id                String     @id @default(uuid()) @db.Uuid
  code              String     @unique @db.VarChar(64)
  type              CouponType
  value             Decimal    @db.Decimal(19, 4)
  currency          String?    @db.Char(3)
  minimumOrderAmount Decimal?  @db.Decimal(19, 4)
  maximumDiscount   Decimal?   @db.Decimal(19, 4)
  usageLimit        Int?
  perBuyerLimit     Int?
  startsAt          DateTime   @db.Timestamptz(6)
  endsAt            DateTime   @db.Timestamptz(6)
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?  @db.Timestamptz(6)
  redemptions       CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
  @@index([deletedAt])
}

model CouponRedemption {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @db.Uuid
  buyerId        String   @db.Uuid
  orderId        String   @db.Uuid
  discountAmount Decimal  @db.Decimal(19, 4)
  redeemedAt     DateTime @default(now()) @db.Timestamptz(6)
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  buyer          User     @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId])
  @@index([buyerId, redeemedAt])
  @@index([couponId, buyerId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.Uuid
  requestId   String?  @db.VarChar(100)
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?  @db.Text
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@index([requestId])
}
